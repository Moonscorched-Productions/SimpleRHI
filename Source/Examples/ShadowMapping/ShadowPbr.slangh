// Cook-Torrance BRDF (GGX, Smith, Schlick). Included by the ShadowMapping shaders.
#pragma once

float D_GGX(float NdotH, float a)
{
    float a2 = a * a;
    float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d + 1e-7);
}

float V_SmithGGX(float NdotV, float NdotL, float a)
{
    float k = a * 0.5;
    return 0.25 / ((NdotV * (1.0 - k) + k) * (NdotL * (1.0 - k) + k) + 1e-7);
}

float3 F_Schlick(float3 F0, float VdotH)
{
    return F0 + (1.0 - F0) * pow(1.0 - VdotH, 5.0);
}

// Outgoing radiance for unit light radiance (includes NdotL).
float3 EvalBRDF(float3 albedo, float metallic, float roughness, float3 N, float3 V, float3 L)
{
    float NdotL = saturate(dot(N, L));
    if (NdotL <= 0.0)
        return float3(0.0);
    float3 H = normalize(V + L);
    float NdotV = max(dot(N, V), 1e-4);
    float NdotH = saturate(dot(N, H));
    float VdotH = saturate(dot(V, H));
    float a = roughness * roughness;
    float3 F0 = lerp(float3(0.04), albedo, metallic);
    float3 F = F_Schlick(F0, VdotH);
    float3 specular = D_GGX(NdotH, a) * V_SmithGGX(NdotV, NdotL, a) * F;
    float3 diffuse = (1.0 - F) * (1.0 - metallic) * albedo / PI;
    return (diffuse + specular) * NdotL;
}
